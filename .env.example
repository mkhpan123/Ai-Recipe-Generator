# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="my_super_secret_jwt_key_for_dev_12345"

# DATABASE_URL: Optional PostgreSQL connection string (e.g., postgresql://user:password@localhost:5432/recipe_db)
# If not provided, an automatic local JSON/disk persistent SQL store is used seamlessly.
DATABASE_URL=""

# PORT: The server port (Fixed to 3000 in AI Studio environment)
PORT=3000

